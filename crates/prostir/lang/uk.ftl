# Тексти програми на ПК із числом: слово стоїть у формі, якої потребує число.
language-name = Українська

limit-monitors = Щонайбільше { $n } { $n ->
    [one] монітор
    [few] монітори
   *[many] моніторів
}
limit-windows = Щонайбільше { $n } { $n ->
    [one] вікно
    [few] вікна
   *[many] вікон
}
limit-physical = Щонайбільше { $n } { $n ->
    [one] екран ПК
    [few] екрани ПК
   *[many] екранів ПК
}
quality-custom = Власна: { $n } Мбіт/с
limit-streams = Щонайбільше { $n } { $n ->
    [one] екран
    [few] екрани
   *[many] екранів
} разом
