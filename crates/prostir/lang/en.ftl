# Texts of the PC app with a count in them: the word takes the plural form the count
# needs. The other texts of the PC app are pairs in the code (src/i18n.rs).
language-name = English

limit-monitors = At most { $n } { $n ->
    [one] monitor
   *[other] monitors
}
limit-windows = At most { $n } { $n ->
    [one] window
   *[other] windows
}
limit-physical = At most { $n } { $n ->
    [one] display of the PC
   *[other] displays of the PC
}
quality-custom = Custom: { $n } Mbit/s
limit-streams = At most { $n } { $n ->
    [one] display
   *[other] displays
} in all
