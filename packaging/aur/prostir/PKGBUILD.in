# Generated by .github/workflows/aur.yml from packaging/aur/prostir/PKGBUILD.in.
pkgname=prostir
pkgver=@VERSION@
pkgrel=1
pkgdesc="Extra KDE Plasma 6 and Hyprland monitors in a Meta Quest 3 or 3S headset (PC part, built from source)"
# aarch64 (Arch Linux ARM, Asahi) is experimental and untested.
arch=('x86_64' 'aarch64')
url="https://prostir.ishawyha.dev"
license=('GPL-3.0-or-later')
# gst-plugin-va: the VA-API encoders (vah264enc, vah265enc, vapostproc).
# gst-plugins-bad-libs: h264parse and h265parse. gst-plugins-good: pulsesrc.
# libpulse: pactl, pacat. pipewire-audio: pw-loopback. mesa: libgbm and the AMD VA driver.
depends=('glibc' 'gcc-libs' 'gstreamer' 'gst-plugins-base-libs' 'gst-plugins-good'
         'gst-plugins-bad-libs' 'gst-plugin-va' 'gst-plugin-pipewire' 'pipewire'
         'pipewire-audio' 'pulse-native-provider' 'libpulse' 'mesa' 'curl'
         # Loaded at run time: wayland by the service too, the rest by the settings window.
         'libglvnd' 'wayland' 'libxkbcommon')
makedepends=('cargo' 'pkgconf' 'clang')
optdepends=('gst-plugins-ugly: encoding on the CPU with x264 (NVIDIA, or no VA-API encoder)'
            'intel-media-driver: hardware encoding on Intel graphics'
            'libkscreen: arranging the monitors on KDE Plasma (kscreen-doctor)'
            'qt6-tools: matching wallpapers on every monitor on KDE Plasma (qdbus6)'
            'kdialog: the pairing dialog (or zenity, fuzzel, wofi, rofi)'
            'zenity: the pairing dialog (or kdialog, fuzzel, wofi, rofi)'
            'libnotify: notifications'
            'grim: screenshots on Hyprland'
            'spectacle: whole-desktop screenshots on KDE when a monitor cannot be captured'
            'android-tools: connecting the headset over USB (developer mode)'
            'libx11: the settings window in an X11 session'
            'libxcursor: the settings window in an X11 session'
            'libxi: the settings window in an X11 session'
            'libxrandr: the settings window in an X11 session'
            'libxrender: the settings window in an X11 session'
            'libxkbcommon-x11: the settings window in an X11 session')
provides=('prostir-bin')
conflicts=('prostir-bin')
# The release's THIRD-PARTY-LICENSES.txt lists the crates compiled into the program;
# the same file ships with every release build.
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/prostir-app/prostir/archive/refs/tags/v${pkgver}.tar.gz"
        "THIRD-PARTY-LICENSES-${pkgver}.txt::https://github.com/prostir-app/prostir/releases/download/v${pkgver}/THIRD-PARTY-LICENSES.txt")
sha256sums=('@SOURCE_SHA256@'
            '@LICENSES_SHA256@')

prepare() {
  cd "prostir-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "prostir-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # makepkg strips and makes the debug package itself: from line tables, not from a
  # program the release profile already stripped.
  export CARGO_PROFILE_RELEASE_DEBUG=1 CARGO_PROFILE_RELEASE_STRIP=false
  cargo build --frozen --release -p prostir --bin prostir
}

check() {
  cd "prostir-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # makepkg strips and makes the debug package itself: from line tables, not from a
  # program the release profile already stripped.
  export CARGO_PROFILE_RELEASE_DEBUG=1 CARGO_PROFILE_RELEASE_STRIP=false
  cargo test --frozen --release -p prostir -p prostir-proto -p prostir-layout -p prostir-lang
}

package() {
  cd "prostir-${pkgver}"
  install -Dm755 target/release/prostir "${pkgdir}/usr/bin/prostir"
  install -Dm644 packaging/io.github.prostir_app.Prostir.desktop "${pkgdir}/usr/share/applications/io.github.prostir_app.Prostir.desktop"
  install -Dm644 packaging/prostir.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/prostir.svg"
  # Not enabled here: Prostir's first start enables the socket for its user (and the
  # preset for new users, where presets apply); the tray turns it off for good.
  install -Dm644 packaging/systemd/prostir.socket "${pkgdir}/usr/lib/systemd/user/prostir.socket"
  install -Dm644 packaging/systemd/prostir.service "${pkgdir}/usr/lib/systemd/user/prostir.service"
  install -Dm644 packaging/systemd/80-prostir.preset "${pkgdir}/usr/lib/systemd/user-preset/80-prostir.preset"
  install -Dm644 packaging/udev/70-prostir-quest.rules "${pkgdir}/usr/lib/udev/rules.d/70-prostir-quest.rules"
  install -Dm644 LICENSE-EXCEPTION.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-EXCEPTION.md"
  install -Dm644 "${srcdir}/THIRD-PARTY-LICENSES-${pkgver}.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-LICENSES.txt"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
