# Частина «Для розробки» в шоломі, лише в його preview-збірці
# (prostir-lang з ознакою `preview` додає цей файл до lang/uk.ftl).

## Налаштування: для розробки

headset-section-dev = Для розробки
headset-dev-size = Розмір моніторів
headset-dev-size-standard = Стандартний
headset-dev-size-one = 1:1
headset-dev-size-main = 1:1 головний
headset-dev-size-85 = 0,85
headset-dev-reset = Скинути розмір
headset-dev-unknown = Модель шолома невідома: лише стандартний розмір.
headset-dev-super-sampling = Згладжування шару
headset-dev-sharpening = Підточування шару
headset-dev-auto = Авто
headset-dev-auto-line = Авто: k щонайменше
headset-dev-line-85 = 0,85
headset-dev-line-90 = 0,9
headset-dev-line-100 = 1,0
headset-dev-metrics = Показники біля монітора
# $rate (Number): megabits a second
headset-dev-mbit = { $rate } Мбіт/с
# $scale (String): headset pixels per monitor pixel, such as 0.98
headset-dev-metrics-scale = { $scale } пікс. шолома на пікс. монітора
# $rate (String): megabits a second, such as 31.5
headset-dev-metrics-rate = { $rate } Мбіт/с
# $size (Number): kilobytes
headset-dev-metrics-keyframe = ключовий кадр { $size } КБ

## Налаштування: руки, спроба кроку 8

headset-section-dev-hands = Руки (спроба)
headset-dev-monitors = Монітори
headset-dev-monitors-on = Дотик і клік
headset-dev-monitors-note = З дотиком і кліком монітори приймають дотик пальцем, щипок і тригер, а кожна рука перемикається між дотиком і променем за тим, як близько палець. Кліки, дотики й прокрутка дійдуть до ПК, коли він прийматиме введення з шолома; доти за променем іде лише вказівник.
headset-dev-take = Узяти монітор
headset-dev-take-fist = Кулаком
headset-dev-take-middle = Щипком середнім
headset-dev-take-hold = Утриманням щипка
headset-dev-hand-look = Вигляд рук
headset-dev-hand-solid = Суцільні
# $percent (Number): наскільки непрозорі, у відсотках
headset-dev-hand-percent = { $percent } %
headset-dev-hand-tips = Кінчики пальців
headset-dev-fx = Ефекти
headset-dev-fx-thin = Тонкі
headset-dev-fx-standard = Стандартні
headset-dev-fx-bold = Яскраві
headset-dev-record = Записати ввід, 30 с
# $seconds (Number): скільки секунд запису лишилось
headset-dev-recording = Запис: { $seconds } с
headset-dev-read-feel = Прочитати feel.txt знову
headset-dev-feel-none = Немає feel.txt: стандартні числа.
# $changed (Number): скільки чисел інші, ніж стандартні; $skipped (Number): скільки рядків не взято
headset-dev-feel-read = feel.txt: змінено чисел: { $changed }, не взято рядків: { $skipped }.
