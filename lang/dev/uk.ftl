# Частина «Для розробки» в шоломі, лише в його preview-збірці
# (prostir-lang з ознакою `preview` додає цей файл до lang/uk.ftl).

## Налаштування: для розробки

headset-section-dev = Для розробки
headset-dev-size = Розмір моніторів
headset-dev-size-standard = Стандартний
headset-dev-size-one = 1:1
headset-dev-size-main = 1:1 головний
headset-dev-size-85 = 0,85
headset-dev-reset = Скинути розмір
headset-dev-unknown = Модель шолома невідома: лише стандартний розмір.
headset-dev-super-sampling = Згладжування шару
headset-dev-sharpening = Підточування шару
headset-dev-auto = Авто
headset-dev-metrics = Показники біля монітора
# $rate (Number): megabits a second
headset-dev-mbit = { $rate } Мбіт/с
# $scale (String): headset pixels per monitor pixel, such as 0.98
headset-dev-metrics-scale = { $scale } пікс. шолома на пікс. монітора
# $rate (String): megabits a second, such as 31.5
headset-dev-metrics-rate = { $rate } Мбіт/с
# $size (Number): kilobytes
headset-dev-metrics-keyframe = ключовий кадр { $size } КБ
